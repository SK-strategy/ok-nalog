{
  "name": "@tax-assistant/convex",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo node_modules",
    "codegen": "pnpm with-env convex codegen",
    "deploy": "pnpm with-env convex deploy",
    "deploy:prod": "pnpm with-prod-env convex deploy",
    "dev": "pnpm with-env convex dev --typecheck=disable",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --",
    "with-prod-env": "dotenv -e ../../.env.prod --"
  },
  "prettier": "@tax-assistant/prettier-config",
  "dependencies": {
    "@convex-dev/better-auth": "^0.12.2",
    "@tax-assistant/validators": "workspace:*",
    "better-auth": "catalog:",
    "better-auth-telegram": "^1.5.0",
    "convex": "catalog:"
  },
  "devDependencies": {
    "@better-auth/cli": "catalog:",
    "@tax-assistant/eslint-config": "workspace:*",
    "@tax-assistant/prettier-config": "workspace:*",
    "@tax-assistant/tsconfig": "workspace:*",
    "dotenv-cli": "^10.0.0",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
