{
  "name": "@tax-assistant/admin",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm with-env next build",
    "clean": "git clean -xdf .cache .next .turbo node_modules",
    "dev": "pnpm with-env next dev --hostname 0.0.0.0 --port 3101 --experimental-https --experimental-https-key ../../certs/dev-key.pem --experimental-https-cert ../../certs/dev-cert.pem",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "start": "pnpm with-env next start",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --"
  },
  "prettier": "@tax-assistant/prettier-config",
  "dependencies": {
    "@convex-dev/better-auth": "^0.12.2",
    "@t3-oss/env-nextjs": "^0.13.8",
    "@tax-assistant/components": "workspace:*",
    "@tax-assistant/convex": "workspace:*",
    "@tax-assistant/ui": "workspace:*",
    "@tax-assistant/validators": "workspace:*",
    "better-auth": "catalog:",
    "better-auth-telegram": "^1.5.0",
    "convex": "catalog:",
    "lucide-react": "^0.548.0",
    "next": "^16.0.9",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tax-assistant/eslint-config": "workspace:*",
    "@tax-assistant/prettier-config": "workspace:*",
    "@tax-assistant/tailwind-config": "workspace:*",
    "@tax-assistant/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "eslint": "catalog:",
    "jiti": "^2.5.1",
    "prettier": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:"
  }
}
