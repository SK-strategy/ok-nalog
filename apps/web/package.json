{
  "name": "@fedor/web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm with-env next build",
    "clean": "git clean -xdf .cache .next .turbo node_modules",
    "dev": "pnpm with-env next dev --hostname 0.0.0.0 --port 3000",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "start": "pnpm with-env next start",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --"
  },
  "prettier": "@fedor/prettier-config",
  "dependencies": {
    "@fedor/convex": "workspace:*",
    "@fedor/ui": "workspace:*",
    "@fedor/validators": "workspace:*",
    "@t3-oss/env-nextjs": "^0.13.8",
    "convex": "catalog:",
    "next": "^16.0.9",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@fedor/eslint-config": "workspace:*",
    "@fedor/prettier-config": "workspace:*",
    "@fedor/tailwind-config": "workspace:*",
    "@fedor/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "eslint": "catalog:",
    "jiti": "^2.5.1",
    "prettier": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:"
  }
}
