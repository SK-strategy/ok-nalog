{
  "name": "@tax-assistant/bot",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "pnpm with-env node --watch --experimental-strip-types src/main.ts",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "start": "pnpm with-env node dist/main.js",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --"
  },
  "prettier": "@tax-assistant/prettier-config",
  "dependencies": {
    "@sentry/node": "^10.69.0",
    "grammy": "^1.30.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tax-assistant/eslint-config": "workspace:*",
    "@tax-assistant/prettier-config": "workspace:*",
    "@tax-assistant/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "dotenv-cli": "^10.0.0",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
