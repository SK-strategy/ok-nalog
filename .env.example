# Since .env is gitignored, you can use .env.example to build a new `.env` file when you clone the repo.
# Keep this file up-to-date when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any secrets in it.
# If you are cloning this repo, create a copy of this file named `.env` and populate it with your secrets.

# ─────────────────────────────── Postgres (docker) ──────────────────────────────
# Brought up by `docker compose up -d`. Credentials match the `postgres` service
# in docker-compose.yml. The Convex backend talks to PG over the docker network
# (postgres://tax_assistant:tax_assistant@postgres:5432) — this host-side URL is
# for migrations, scripts, or `psql` from your machine.
POSTGRES_URL="postgres://tax_assistant:tax_assistant@127.0.0.1:5532/tax_assistant"

# ───────────────────────────── Convex (self-hosted) ─────────────────────────────
# After `docker compose up -d`, fetch the admin key:
#   docker compose exec convex-backend ./generate_admin_key.sh
# Then paste it below.
CONVEX_SELF_HOSTED_URL="http://192.168.31.81:3310"
CONVEX_SELF_HOSTED_ADMIN_KEY="tax_assistant|014d2b1e19de0486a778dcb2187e4231ac8d63ca5b34115522a08f86a83ed02750e6c70e02"

# Browser-facing Convex URL — Caddy HTTPS proxy → convex-backend:3210.
# Switch to HTTP-direct on :3310 if you don't need HTTPS (no TMA testing).
# Read in RootLayout (server component) and passed down to client providers.
# Not NEXT_PUBLIC_* — that prefix would inline the value into the client bundle
# and defeat the runtime-env design (see DEPLOY.md).
CONVEX_URL="https://192.168.31.81:3320"
# Convex HTTP actions origin (HTTPS via Caddy → :3211). Hosts better-auth
# /api/auth/* including the Telegram OIDC callback.
CONVEX_SITE_URL="https://192.168.31.81:3321"

# ───────────────────────────── App origins (CORS) ───────────────────────────────
# Origins better-auth trusts for /api/auth/* CORS preflight + cookie writes.
# Apps dev-serve on `--hostname 0.0.0.0 --experimental-https` so they're
# reachable both at 127.0.0.1 and the LAN IP — use whichever origin the
# browser actually loads from (LAN IP is required for TMA on a real phone).
# Read inside Convex functions, so they need to be set on the deployment:
#   pnpm with-env npx convex env set WEB_ORIGIN <value>
WEB_ORIGIN="https://192.168.31.81:3100"
ADMIN_ORIGIN="https://192.168.31.81:3101"
TMA_ORIGIN="https://192.168.31.81:3102"

# ─────────────────────────────── better-auth ────────────────────────────────────
# Long random string (>= 32 bytes). Must also be set on the Convex deployment:
#   pnpm with-env npx convex env set BETTER_AUTH_SECRET <value>
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="359c88d5be2909314aa6718f0b184e62ec0d8a699bee45e0e1641862d4e55fdd"

# ──────────────────────────────── Telegram auth ─────────────────────────────
# Server-side Telegram vars are read inside Convex functions — they need to be
# set on the deployment, not just here:
#   pnpm with-env npx convex env set TELEGRAM_BOT_TOKEN <value>
# Token from @BotFather; the bot also hosts the Mini App.
TELEGRAM_BOT_TOKEN="123456789:replace-with-your-BotFather-token"
# Admin promotion is no longer driven by env. Edit the `users.role` field
# directly in the Convex dashboard to promote a user (customer → admin).
# Public bot username (no @) — used by the telegram plugin server-side.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="Oknalog_net_bot"

# ──────────────────────────────── Resend (email OTP) ────────────────────────
# Delivers the 6-digit login/link/merge codes for email auth. The Convex
# backend reads these from its DEPLOYMENT env (set via `convex env set`), NOT
# from this file — setting them here alone does nothing. Set BOTH:
#   pnpm with-env npx convex env set RESEND_API_KEY <value>
#   pnpm with-env npx convex env set RESEND_FROM "Налоговый помощник <auth@yourdomain>"
# RESEND_FROM MUST use a domain verified at resend.com/domains. If it's unset
# (or the domain is unverified), the code falls back to onboarding@resend.dev,
# which Resend only lets you mail to the account owner's own address — every
# other recipient gets a 403. Leave RESEND_API_KEY empty in dev to skip
# sending entirely (codes are printed to the Convex function log instead).
RESEND_API_KEY=""
RESEND_FROM=""

# ──────────────────────────────── Telegram OIDC ─────────────────────────────
# Real OIDC flow at oauth.telegram.org. Requires a permanent BotFather setup:
# Open @BotFather **as a mini app**, Bot Settings → Web Login, add+remove your
# site URL, then "OpenID Connect Login" appears — this is a one-way switch.
# Register Allowed URL = your origin, Redirect URL =
#   <CONVEX_SITE_URL>/api/auth/callback/telegram-oidc
# BotFather then issues Client ID + Client Secret. The Client Secret is NOT the
# bot token. Both must also be set on the Convex deployment.
TELEGRAM_OIDC_CLIENT_ID=""
TELEGRAM_OIDC_CLIENT_SECRET=""

# ──────────────────────────────── Payments ──────────────────────────────────
# Which gateway confirms customer payments. `mock` (default / dev) wires a
# self-confirming checkout so the customer → paid flow works with no real PSP —
# opening the checkout URL immediately marks the order paid. Switch to a real
# provider (`yookassa` | `telegram`) in prod and implement its hosted-intent
# creation in payments.checkout + its signature scheme in lib/payments.ts.
# Set on the Convex deployment too:
#   pnpm with-env npx convex env set PAYMENTS_PROVIDER <value>
PAYMENTS_PROVIDER="mock"
# HMAC-SHA256 key the provider webhook (/payments/webhook) is verified against
# (header `x-signature`, hex). Required for any real provider; unused by `mock`.
#   pnpm with-env npx convex env set PAYMENTS_WEBHOOK_SECRET <value>
PAYMENTS_WEBHOOK_SECRET=""

# ──────────────────────────────── Sentry ────────────────────────────────────
# Error reporting for the three Next.js apps. Entirely optional: with no DSN
# set the SDK initialises nothing, so leaving this block empty is a supported
# configuration (see apps/*/src/instrumentation.ts).
#
# Two DSN vars because they're read in two places. They normally hold the SAME
# value — the DSN is a public, write-only ingest key.
SENTRY_DSN=""
# NOTE: NEXT_PUBLIC_ is inlined into the client bundle at BUILD time, so unlike
# CONVEX_URL this one is baked into the image and changing it needs a rebuild.
NEXT_PUBLIC_SENTRY_DSN=""

# Source-map upload at build time. Without SENTRY_AUTH_TOKEN the upload step is
# skipped and the build still succeeds — stack traces just stay minified.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
