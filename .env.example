# Since .env is gitignored, you can use .env.example to build a new `.env` file when you clone the repo.
# Keep this file up-to-date when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any secrets in it.
# If you are cloning this repo, create a copy of this file named `.env` and populate it with your secrets.

# ─────────────────────────────── Postgres (docker) ──────────────────────────────
# Brought up by `docker compose up -d`. Credentials match the `postgres` service
# in docker-compose.yml. The Convex backend talks to PG over the docker network
# (postgres://tax_assistant:tax_assistant@postgres:5432) — this host-side URL is
# for migrations, scripts, or `psql` from your machine.
POSTGRES_URL="postgres://tax_assistant:tax_assistant@127.0.0.1:5532/tax_assistant"

# ───────────────────────────── Convex (self-hosted) ─────────────────────────────
# After `docker compose up -d`, fetch the admin key:
#   docker compose exec convex-backend ./generate_admin_key.sh
# Then paste it below.
CONVEX_SELF_HOSTED_URL="http://192.168.31.81:3310"
CONVEX_SELF_HOSTED_ADMIN_KEY=""

# Browser-facing Convex URL — Caddy HTTPS proxy → convex-backend:3210.
# Switch to HTTP-direct on :3310 if you don't need HTTPS (no TMA testing).
NEXT_PUBLIC_CONVEX_URL="https://192.168.31.81:3320"
# Convex HTTP actions origin (HTTPS via Caddy → :3211). Hosts better-auth
# /api/auth/* including the Telegram OIDC callback.
NEXT_PUBLIC_CONVEX_SITE_URL="https://192.168.31.81:3311"

# ─────────────────────────────── better-auth ────────────────────────────────────
# Long random string (>= 32 bytes). Must also be set on the Convex deployment:
#   pnpm with-env npx convex env set BETTER_AUTH_SECRET <value>
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=""

# ──────────────────────────────── Telegram auth ─────────────────────────────
# Server-side Telegram vars are read inside Convex functions — they need to be
# set on the deployment, not just here:
#   pnpm with-env npx convex env set TELEGRAM_BOT_TOKEN <value>
# Token from @BotFather; the bot also hosts the Mini App.
TELEGRAM_BOT_TOKEN=""
# Comma-separated Telegram numeric user ids promoted to admin on first login.
TELEGRAM_ADMIN_IDS=""
# Public bot username (no @) — used by the telegram plugin server-side.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""

# ──────────────────────────────── Telegram OIDC ─────────────────────────────
# Real OIDC flow at oauth.telegram.org. Requires a permanent BotFather setup:
# Open @BotFather **as a mini app**, Bot Settings → Web Login, add+remove your
# site URL, then "OpenID Connect Login" appears — this is a one-way switch.
# Register Allowed URL = your origin, Redirect URL =
#   <NEXT_PUBLIC_CONVEX_SITE_URL>/api/auth/callback/telegram-oidc
# BotFather then issues Client ID + Client Secret. The Client Secret is NOT the
# bot token. Both must also be set on the Convex deployment.
TELEGRAM_OIDC_CLIENT_ID=""
TELEGRAM_OIDC_CLIENT_SECRET=""
