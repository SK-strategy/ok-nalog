# Production env for tax-assistant.
# Copy to /opt/tax-assistant/.env on the VPS. docker-compose loads it
# automatically and substitutes ${VAR} references in docker-compose.prod.yml +
# Caddyfile.prod.
#
# Generate every secret fresh — do NOT reuse the dev values from .env.example.
# Most "openssl rand …" commands below can run on either your laptop or the VPS.

# ════════════════════════════════════════════════════════════════════════════
# LAYER A — container env
# Loaded by docker-compose on startup. Affects how containers boot.
# ════════════════════════════════════════════════════════════════════════════

# ─── Image tags. Set to the SHA you just pushed; bump on every deploy. ──
WEB_IMAGE=ghcr.io/netosha/tax-assistant-web:latest
ADMIN_IMAGE=ghcr.io/netosha/tax-assistant-admin:latest
TMA_IMAGE=ghcr.io/netosha/tax-assistant-tma:latest

# ─── Postgres ──────────────────────────────────────────────────────────
POSTGRES_USER=tax_assistant
# openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=tax_assistant

# ─── Convex backend self-hosting ──────────────────────────────────────
INSTANCE_NAME=tax_assistant
# openssl rand -hex 32 — rotating this invalidates the admin key.
INSTANCE_SECRET=
# Both point at the same public hostname; Caddy path-routes Cloud vs Site.
CONVEX_CLOUD_ORIGIN=https://api.oknalog.net
CONVEX_SITE_ORIGIN=https://api.oknalog.net
DISABLE_BEACON=true
REDACT_LOGS_TO_CLIENT=true
# Filled in AFTER first boot — see DEPLOY.md "step 4".
CONVEX_SELF_HOSTED_ADMIN_KEY=

# ─── App runtime env (read at request time in RootLayout) ─────────────
# These are NOT NEXT_PUBLIC_* — they don't bake into the client bundle. Change
# them and restart the app container; no rebuild required.
CONVEX_URL=https://api.oknalog.net
CONVEX_SITE_URL=https://api.oknalog.net

# ─── Caddy ────────────────────────────────────────────────────────────
# Email tied to your Let's Encrypt account — expiration warnings go here.
LE_EMAIL=dmitriypru@gmail.com

# ─── Dashboard basic auth (Caddy) ─────────────────────────────────────
# bcrypt hash. Generate with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '<chosen pw>'
# IMPORTANT: in compose, $ must be escaped as $$ — paste the raw hash here and
# docker-compose does the right thing (literal $).
DASHBOARD_USER=admin
DASHBOARD_BCRYPT=

# ════════════════════════════════════════════════════════════════════════════
# LAYER B — Convex DEPLOYMENT env
# NOT loaded by docker. Set via `npx convex env set <KEY> <VALUE>` from your
# laptop, pointed at the running prod backend. Stored inside Postgres.
# See DEPLOY.md "step 6".
#
# The values listed here are documentation only — the variable names. The
# secrets live on the deployment, not in this file.
# ════════════════════════════════════════════════════════════════════════════

# Set with:  pnpm -F @tax-assistant/convex with-env npx convex env set <KEY> <VALUE>
# Verify:    pnpm -F @tax-assistant/convex with-env npx convex env list
#
# JWKS                        — RS256 keypair better-auth signs JWTs with.
#                               Bootstrap sequence in DEPLOY.md "step 5".
# BETTER_AUTH_SECRET          — openssl rand -hex 32
# TELEGRAM_BOT_TOKEN          — from @BotFather (NOT the OIDC client secret)
# NEXT_PUBLIC_TELEGRAM_BOT_USERNAME = Oknalog_net_bot
#                               (no @ prefix; keeps NEXT_PUBLIC_ prefix because
#                               the better-auth telegram plugin reads it as-is)
# WEB_ORIGIN                  = https://oknalog.net      (trustedOrigins for cookies)
# ADMIN_ORIGIN                = https://admin.oknalog.net
# TMA_ORIGIN                  = https://tma.oknalog.net
# TELEGRAM_OIDC_CLIENT_ID     — from BotFather "OpenID Connect Login" ritual
# TELEGRAM_OIDC_CLIENT_SECRET — same, NOT the bot token

# ════════════════════════════════════════════════════════════════════════════
# LAYER C — local-only env (your laptop, NOT on the VPS)
# Used to run `pnpm convex deploy` against the prod backend.
# Put these in a local .env.prod (gitignored), not on the VPS.
# ════════════════════════════════════════════════════════════════════════════

# CONVEX_SELF_HOSTED_URL=https://api.oknalog.net
# CONVEX_SELF_HOSTED_ADMIN_KEY=<same value as on the VPS>
