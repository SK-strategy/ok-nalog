# Production env for tax-assistant.
# Copy to /opt/tax-assistant/.env on the VPS. docker-compose loads it
# automatically and substitutes ${VAR} references in docker-compose.prod.yml +
# Caddyfile.prod.
#
# This file is committed to git — keep it as a placeholder template, NEVER
# fill in real secrets here. Generate fresh values when you deploy; the
# real .env on the VPS is gitignored. Comments next to each blank show how
# to generate or where to source the value.

# ════════════════════════════════════════════════════════════════════════════
# LAYER A — container env
# Loaded by docker-compose on startup. Affects how containers boot.
# ════════════════════════════════════════════════════════════════════════════

# ─── Image tags. Bump on every deploy after pushing new images. ────────
WEB_IMAGE=ghcr.io/netosha/tax-assistant-web:latest
ADMIN_IMAGE=ghcr.io/netosha/tax-assistant-admin:latest
TMA_IMAGE=ghcr.io/netosha/tax-assistant-tma:latest
BOT_IMAGE=ghcr.io/netosha/tax-assistant-bot:latest

# ─── Postgres ──────────────────────────────────────────────────────────
POSTGRES_USER=tax_assistant
# openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=tax_assistant

# ─── Convex backend self-hosting ──────────────────────────────────────
INSTANCE_NAME=tax_assistant
# openssl rand -hex 32 — rotating this invalidates the admin key, so set
# once and don't change.
INSTANCE_SECRET=
# Both point at the same public hostname; Caddy path-routes Cloud vs Site.
CONVEX_CLOUD_ORIGIN=https://api.oknalog.net
CONVEX_SITE_ORIGIN=https://api.oknalog.net
DISABLE_BEACON=true
REDACT_LOGS_TO_CLIENT=true
# Format: <instance_name>|<hex>. Generated by the convex-backend container
# after first boot — see DEPLOY.md step 4 (./generate_admin_key.sh). Don't
# paste anything else here (an SSH private key, for instance) — Convex will
# silently reject the auth on every CLI call.
CONVEX_SELF_HOSTED_ADMIN_KEY=

# ─── App runtime env (read at request time in RootLayout) ─────────────
# These are NOT NEXT_PUBLIC_* — they don't bake into the client bundle. Change
# them and restart the app container; no rebuild required.
CONVEX_URL=https://api.oknalog.net
CONVEX_SITE_URL=https://api.oknalog.net

# ─── Notification bot (apps/bot) ──────────────────────────────────────
# Reuses TELEGRAM_BOT_TOKEN — the SAME bot as the Mini App and Login Widget.
# Only one instance may run: Telegram permits a single long-polling consumer
# per token, so never scale the `bot` service past one replica.
TELEGRAM_BOT_TOKEN=
WEB_ORIGIN=https://oknalog.net
# Shared secret for the /bot/* Convex HTTP actions. openssl rand -hex 32.
# The SAME value must also be set as a Convex *deployment* var (layer B) —
# the endpoints fail shut if it's missing there.
BOT_SERVICE_SECRET=

# ─── Caddy ────────────────────────────────────────────────────────────
# Email tied to your Let's Encrypt account — expiration warnings go here.
LE_EMAIL=

# ─── Convex dashboard basic auth (convex.admin.oknalog.net) ───────────
# bcrypt hash. Generate with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '<chosen pw>'
# Save the plaintext password in your password manager — bcrypt is one-way.
DASHBOARD_USER=admin
DASHBOARD_BCRYPT=

# ════════════════════════════════════════════════════════════════════════════
# LAYER B — Convex DEPLOYMENT env
# NOT loaded by docker. Set via `npx convex env set <KEY> <VALUE>` from your
# laptop, pointed at the running prod backend. Stored inside Postgres.
# See DEPLOY.md "step 6".
#
# Documented here for reference. Never paste actual values into this file.
# ════════════════════════════════════════════════════════════════════════════

# Set with:  pnpm -F @tax-assistant/convex with-prod-env npx convex env set <KEY> <VALUE>
# Verify:    pnpm -F @tax-assistant/convex with-prod-env npx convex env list
#
# JWKS                              — RS256 keypair better-auth signs JWTs with.
#                                     Bootstrap sequence in DEPLOY.md "step 5".
# BETTER_AUTH_SECRET                — openssl rand -hex 32
# TELEGRAM_BOT_TOKEN                — from @BotFather (NOT the OIDC client secret)
# NEXT_PUBLIC_TELEGRAM_BOT_USERNAME — bot @ name without the @ prefix.
#                                     Keeps NEXT_PUBLIC_ because the better-auth
#                                     telegram plugin reads it as-is.
# WEB_ORIGIN                        — https://oknalog.net      (trustedOrigins)
# ADMIN_ORIGIN                      — https://admin.oknalog.net
# TMA_ORIGIN                        — https://tma.oknalog.net
# TELEGRAM_OIDC_CLIENT_ID           — from BotFather "OpenID Connect Login" ritual
# TELEGRAM_OIDC_CLIENT_SECRET       — same, NOT the bot token
# BOT_SERVICE_SECRET                — same value as layer A above. Authenticates
#                                     apps/bot against the /bot/* HTTP actions.
#                                     If unset here, those routes reject every
#                                     request (fail shut) and no notification
#                                     is ever delivered.
# RESEND_API_KEY                    — resend.com API key for email-OTP login.
#                                     Unset → codes are logged to the Convex
#                                     function log instead of being emailed.
# RESEND_FROM                       — sender, e.g. "Налоговый помощник <auth@oknalog.net>".
#                                     Domain must be verified in Resend.

# ════════════════════════════════════════════════════════════════════════════
# LAYER C — local-only env (your laptop, NOT on the VPS)
# Used to run `pnpm convex deploy` against the prod backend.
# Put these in a local .env.prod (gitignored), not on the VPS.
# ════════════════════════════════════════════════════════════════════════════

# CONVEX_SELF_HOSTED_URL=https://api.oknalog.net
# CONVEX_SELF_HOSTED_ADMIN_KEY=<same value as on the VPS>
