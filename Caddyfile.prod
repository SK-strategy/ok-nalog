# Production Caddyfile. Домен берётся из переменной DOMAIN (.env на сервере).
# Mounted into the caddy container; needs DNS A records for every hostname
# below pointing at the VPS before Let's Encrypt will issue.

{
    email {$LE_EMAIL}
    # auto_https stays ON (default) — Caddy mints LE certs for every host block.
}

# ─────────────────────────────── Public site ────────────────────────────────
{$DOMAIN} {
    reverse_proxy web:3000
}

# Canonical → apex. 308 keeps method on POSTs.
www.{$DOMAIN} {
    redir https://{$DOMAIN}{uri} 308
}

# ─────────────────────────────────── Admin ──────────────────────────────────
admin.{$DOMAIN} {
    reverse_proxy admin:3000
}

# ──────────────────────────── Telegram Mini App ─────────────────────────────
tma.{$DOMAIN} {
    reverse_proxy tma:3000
}

# ─────────────────────────── Convex (Cloud + Site) ──────────────────────────
# One public hostname collapses both Convex servers:
#   :3210 — Cloud API (queries/mutations + WebSocket sync at /api/sync)
#   :3211 — Site (HTTP actions; better-auth /api/auth/* + /.well-known/*)
# Site paths are a fixed allowlist below. Anything else falls through to Cloud.
# If you ever add HTTP actions outside /api/auth/* or /.well-known/*, extend
# the @site matcher here.
api.{$DOMAIN} {
    @site {
        path /api/auth*
        path /.well-known/*
        # apps/bot's outbox endpoints (pending/ack/chat). Without this they
        # fall through to Cloud on :3210 and the worker logs a bare
        # `/bot/pending → 404 Not Found` every poll — authenticated with
        # Telegram, but never delivering anything.
        path /bot/*
    }
    handle @site {
        reverse_proxy convex-backend:3211
    }
    handle {
        reverse_proxy convex-backend:3210
    }
}

# ─────────────────────────── Convex dashboard ───────────────────────────────
# Sub-subdomain under admin.{$DOMAIN}. Caddy basic auth is the perimeter;
# the dashboard's own admin-key login still applies inside.
convex.admin.{$DOMAIN} {
    basic_auth {
        {$DASHBOARD_USER} {$DASHBOARD_BCRYPT}
    }
    reverse_proxy convex-dashboard:6791
}
